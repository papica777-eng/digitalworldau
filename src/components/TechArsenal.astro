---

<section class="section" id="stack" aria-labelledby="stack-heading">
  <div class="container">
    <div class="section-header section-header--centered" data-reveal>
      <span class="eyebrow">Technology Stack</span>
      <h2 class="section-title" id="stack-heading">Our Technological Arsenal</h2>
      <p class="section-lead">
        Precision design tooling, compiled WebAssembly &amp; Astro islands, battle-tested CMS platforms, and hardened container infrastructure.
      </p>
    </div>

    <div class="tech-grid" data-reveal>
      {tools.map((tool) => (
        <div class="tech-card" data-glow-card style={`--tool-accent: ${tool.color}`}>
          <div class="tech-card__icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" set:html={tool.svg} />
          </div>
          <div class="tech-card__meta">
            <strong>{tool.name}</strong>
            <span>{tool.category}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.05rem;

    @include respond-up(sm) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @include respond-up(lg) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tech-card {
    @include interactive-card;
    border-radius: $radius-md;
    padding: 1.25rem 1.35rem;
    display: flex;
    align-items: center;
    gap: 1rem;

    &:hover {
      border-color: var(--tool-accent);
    }

    &__icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 0 24px rgba(1, 106, 212, 0.18);
      flex-shrink: 0;
    }

    &__meta {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;

      strong {
        font-size: 0.98rem;
        color: $text-primary;
      }

      span {
        font-size: 0.77rem;
        color: $text-muted;
      }
    }
  }
</style>
