---
import { SERVICES_BENTO } from '../data/agencyData';
---

<section class="section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="eyebrow">Core Capabilities</span>
      <h2 class="section-title" id="services-heading">Four integrated disciplines engineered for compounding growth.</h2>
      <p class="section-lead">
        Strategy, Awwwards-grade design, full-stack engineering, and measurable acquisition operating as one unified Australian &amp; global squad.
      </p>
    </div>

    <div class="bento-services">
      {SERVICES_BENTO.map((service, idx) => (
        <article class="service-card" id={`service-${service.step}`} data-glow-card data-reveal>
          <div class="service-card__viz" aria-hidden="true">
            {idx === 0 && (
              <svg viewBox="0 0 260 110" class="viz-svg" aria-hidden="true" focusable="false">
                <defs>
                  <linearGradient id="auditGrad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#00f5a0"/>
                    <stop offset="100%" stop-color="#016ad4"/>
                  </linearGradient>
                </defs>
                <circle cx="58" cy="55" r="38" stroke="rgba(255,255,255,0.08)" stroke-width="7" fill="none"/>
                <circle cx="58" cy="55" r="38" stroke="url(#auditGrad)" stroke-width="7" stroke-dasharray="226 240" stroke-linecap="round" fill="none" transform="rotate(-90 58 55)"/>
                <path d="M45 55.5 54 64.5 72 46.5" stroke="#00f5a0" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <rect x="116" y="24" width="124" height="14" rx="7" fill="rgba(255,255,255,0.06)"/>
                <rect x="116" y="24" width="114" height="14" rx="7" fill="#00f5a0" opacity="0.85"/>
                <rect x="116" y="48" width="124" height="14" rx="7" fill="rgba(255,255,255,0.06)"/>
                <rect x="116" y="48" width="106" height="14" rx="7" fill="#38bdf8" opacity="0.85"/>
                <rect x="116" y="72" width="124" height="14" rx="7" fill="rgba(255,255,255,0.06)"/>
                <rect x="116" y="72" width="120" height="14" rx="7" fill="#fcc1f4" opacity="0.85"/>
              </svg>
            )}
            {idx === 1 && (
              <svg viewBox="0 0 260 110" class="viz-svg" aria-hidden="true" focusable="false">
                <rect x="18" y="18" width="140" height="74" rx="12" fill="rgba(1,106,212,0.18)" stroke="rgba(132,181,230,0.35)"/>
                <rect x="30" y="30" width="64" height="10" rx="5" fill="#ffffff" opacity="0.9"/>
                <rect x="30" y="46" width="98" height="7" rx="3.5" fill="rgba(255,255,255,0.4)"/>
                <rect x="30" y="64" width="52" height="16" rx="8" fill="#00f5a0"/>
                <rect x="136" y="32" width="104" height="62" rx="12" fill="rgba(95,31,87,0.55)" stroke="#fcc1f4" stroke-width="1.2"/>
                <circle cx="156" cy="52" r="8" fill="#fcc1f4"/>
                <circle cx="178" cy="52" r="8" fill="#016ad4"/>
                <circle cx="200" cy="52" r="8" fill="#00f5a0"/>
                <path d="M196 76l8 16 4-7 7-3-19-6Z" fill="#ffffff"/>
              </svg>
            )}
            {idx === 2 && (
              <svg viewBox="0 0 260 110" class="viz-svg" aria-hidden="true" focusable="false">
                <rect x="14" y="16" width="232" height="78" rx="12" fill="rgba(5,9,22,0.45)" stroke="rgba(56,189,248,0.32)"/>
                <circle cx="30" cy="30" r="3.5" fill="#fb7185"/>
                <circle cx="42" cy="30" r="3.5" fill="#ffc200"/>
                <circle cx="54" cy="30" r="3.5" fill="#00f5a0"/>
                <rect x="28" y="46" width="136" height="8" rx="4" fill="#00f5a0" opacity="0.88"/>
                <rect x="28" y="62" width="108" height="8" rx="4" fill="#84b5e6" opacity="0.82"/>
                <rect x="28" y="76" width="122" height="8" rx="4" fill="#fcc1f4" opacity="0.82"/>
                <path d="M204 42l-10 16h9l-4 15 14-18h-9l4-13Z" fill="#00f5a0" opacity="0.92"/>
              </svg>
            )}
            {idx === 3 && (
              <svg viewBox="0 0 260 110" class="viz-svg" aria-hidden="true" focusable="false">
                <defs>
                  <linearGradient id="growthArea" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#00f5a0" stop-opacity="0.42"/>
                    <stop offset="100%" stop-color="#00f5a0" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M18 88 C65 84, 95 62, 138 54 C178 46, 205 24, 242 18 L242 94 L18 94 Z" fill="url(#growthArea)"/>
                <path d="M18 88 C65 84, 95 62, 138 54 C178 46, 205 24, 242 18" fill="none" stroke="#00f5a0" stroke-width="3" stroke-linecap="round"/>
                <circle cx="242" cy="18" r="5" fill="#ffffff" stroke="#00f5a0" stroke-width="3"/>
                <rect x="24" y="18" width="64" height="28" rx="14" fill="rgba(0,245,160,0.14)" stroke="rgba(0,245,160,0.4)"/>
                <path d="M38 36 47 27 53 33 65 21 M58 21h7v7" stroke="#00f5a0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            )}
          </div>

          <div class="service-card__top">
            <span class="service-card__step">{service.step}</span>
            <span class="tag">{service.highlight}</span>
          </div>

          <h3>{service.title}</h3>
          <p class="service-card__sub">{service.subtitle}</p>

          <ul>
            {service.items.map((item) => (
              <li>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="#contact" data-preset-service={service.preset} class="service-card__link">
            Discuss {service.title}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .bento-services {
    display: grid;
    gap: 1.35rem;
    grid-template-columns: 1fr;

    @include respond-up(sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include respond-up(xl) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service-card {
    @include interactive-card;
    padding: 1.45rem;
    display: flex;
    flex-direction: column;

    &__viz {
      margin-bottom: 1.25rem;
      border-radius: $radius-md;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;

      .viz-svg {
        width: 100%;
        height: auto;
      }
    }

    &__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 1rem;
    }

    &__step {
      font-family: $font-mono;
      font-size: 0.85rem;
      font-weight: 700;
      color: $accent-cobalt;
    }

    h3 {
      margin: 0 0 0.35rem;
      font-family: $font-display;
      font-size: 1.28rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    &__sub {
      margin: 0 0 1.15rem;
      color: $text-secondary;
      font-size: 0.9rem;
    }

    ul {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      flex: 1;

      li {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        font-size: 0.89rem;
        color: #e2e8f0;

        svg {
          color: $accent-blue-light;
          margin-top: 0.22rem;
          flex-shrink: 0;
        }
      }
    }

    &__link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.88rem;
      font-weight: 600;
      color: $accent-blue-light;
      transition: gap $transition-fast, color $transition-fast;

      &:hover {
        gap: 0.7rem;
        color: #ffffff;
      }
    }
  }
</style>
