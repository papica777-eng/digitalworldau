---
import BrandLogo from './BrandLogo.svelte';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <BrandLogo compact={true} />
      <p>
        High-converting web design, bespoke e-commerce engineering, and performance marketing crafted in Australia for ambitious global brands.
      </p>
      <div class="footer-contact">
        <a href="mailto:hello@digitalworldau.com">hello@digitalworldau.com</a>
        <a href="tel:+61423269586">AU Desk: +61 423 269 586 (Melbourne &amp; Sydney)</a>
        <a href="tel:+359896849882">EU / BG Desk: +359 896 849 882 (Sofia &amp; Burgas)</a>
        <span>AU: 56 Mantung Cres, Rowville, Melbourne VIC 3178</span>
        <span>EU: 6 Trapezitsa St, 8200 Pomorie (Burgas) &amp; Sofia, Bulgaria</span>
      </div>
    </div>

    <div class="footer-col">
      <h4>Services &amp; Cities</h4>
      <ul>
        <li><a href="/free-website-audit/">Free 48-Hour Website Audit</a></li>
        <li><a href="/web-design-melbourne/">Web Design Melbourne</a></li>
        <li><a href="/web-design-sydney/">Web Design Sydney</a></li>
        <li><a href="/ecommerce-australia/">E-Commerce Australia</a></li>
        <li><a href="/blog/">Knowledge Hub &amp; Playbooks</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Flagship Platforms</h4>
      <ul>
        <li><a href="https://anchialo.com" target="_blank" rel="noopener">anchialo.com — Magnesium AU ↗</a></li>
        <li><a href="https://cptmma.com" target="_blank" rel="noopener">cptmma.com — CPT MMA Melbourne ↗</a></li>
        <li><a href="https://immersionmma.com.au" target="_blank" rel="noopener">immersionmma.com.au — Immersion MMA Melbourne ↗</a></li>
        <li><a href="https://www.paintersofgeelong.com.au" target="_blank" rel="noopener">paintersofgeelong.com.au — Painters of Geelong ↗</a></li>
        <li><a href="https://papica777-eng.github.io/aeterna-cosmic-observatory/" target="_blank" rel="noopener">ASTRO Cosmic Observatory — 4K Planetarium ↗</a></li>
        <li><a href="https://aeterna.website" target="_blank" rel="noopener">aeterna.website — Sovereign 3D Platform ↗</a></li>
        <li><a href="https://nasvetlo.website" target="_blank" rel="noopener">nasvetlo.website — 2.23M-Record Civic Audit ↗</a></li>
        <li><a href="/#projects">Case Studies &amp; Work</a></li>
        <li><a href="/#stack">Tech Arsenal</a></li>
        <li><a href="/#blog">Knowledge Hub</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Legal &amp; Trust</h4>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Engagement</a></li>
        <li>
          <button
            type="button"
            class="footer-cookie-btn"
            onclick="window.dispatchEvent(new Event('dw:open-cookies'))"
          >
            Cookie Settings
          </button>
        </li>
        <li><a href="/#contact">IP Ownership Guarantee</a></li>
        <li><a href="/">digitalworldau.com</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Digital World AU. All rights reserved. Crafted in Melbourne, Sydney &amp; Bulgaria (EU).</p>
    <p class="footer-tech">Fast-Loading Websites • E-Commerce • Google Ads Conversion Architecture</p>
  </div>
</footer>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(16px) saturate(145%);
    -webkit-backdrop-filter: blur(16px) saturate(145%);
    padding-block: 4rem 2rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.25rem;
    grid-template-columns: 1fr;

    @include respond-up(sm) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include respond-up(lg) {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer-brand p {
    margin: 1rem 0 1.25rem;
    color: $text-secondary;
    font-size: 0.9rem;
    max-width: 38ch;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.86rem;

    a {
      color: $accent-blue-light;
      font-weight: 600;
    }

    span {
      color: $text-muted;
    }
  }

  .footer-col {
    h4 {
      margin: 0 0 1rem;
      font-family: $font-mono;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: $accent-blue-light;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.6rem;

      a,
      .footer-cookie-btn {
        font-size: 0.9rem;
        color: $text-secondary;
        transition: color $transition-fast;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        text-align: left;

        &:hover {
          color: #ffffff;
        }
      }
    }
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: $text-muted;

    p {
      margin: 0;
    }
  }

  .footer-tech {
    font-family: $font-mono;
    font-size: 0.76rem;
    color: $text-secondary;
  }
</style>
