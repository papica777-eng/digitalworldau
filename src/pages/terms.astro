---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderNav from '../components/HeaderNav.svelte';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Terms of Engagement — Digital World AU" canonical="https://digitalworldau.com/terms/" pageType="legal">
  <HeaderNav client:load />
  <main class="section">
    <div class="container legal-wrap">
      <span class="eyebrow">Commercial Terms</span>
      <h1 class="section-title">Terms of Engagement</h1>
      <p class="section-lead">
        Transparent, fixed-scope commercial terms governing complimentary website audits, UI/UX design sprints, custom development, and 100% client IP ownership.
      </p>
      <div class="legal-card">
        <h2>1. Full Intellectual Property Ownership</h2>
        <p>Upon settlement of the final project milestone, 100% of custom source code, Figma design systems, WebAssembly modules, and bespoke digital assets created for your project transfer exclusively to your business.</p>

        <h2>2. Fixed-Scope Milestones &amp; Currency</h2>
        <p>Proposals are issued in Australian Dollars (AUD) or Euros (EUR) with clearly defined deliverables, staging review rounds, and zero surprise hourly overages.</p>

        <h2>3. Free 48-Hour Expert Website Audit</h2>
        <p>Complimentary UX, Core Web Vitals, and Technical SEO audits carry zero contractual obligation and are delivered as a written action roadmap within 48 hours.</p>

        <h2>4. Governing Law &amp; Direct Contact</h2>
        <p>Australian commercial engagements are governed by the laws of Victoria, Australia, while European Union engagements are governed by Bulgarian and EU commercial law. Questions may be sent to <a href="mailto:hello@digitalworldau.com">hello@digitalworldau.com</a>, or handled directly by phone via our Australian Desk (<a href="tel:+61423269586">+61 423 269 586</a>) or European HQ (<a href="tel:+359896849882">+359 896 849 882</a>).</p>

        <a href="/" class="btn btn-ghost">← Return to Digital World AU</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .legal-wrap {
    max-width: 820px;
  }

  .legal-card {
    @include glass-surface;
    border-radius: $radius-lg;
    padding: 2rem;
    margin-top: 2rem;

    h2 {
      margin: 1.5rem 0 0.5rem;
      font-size: 1.15rem;

      &:first-child {
        margin-top: 0;
      }
    }

    p {
      margin: 0 0 1rem;
      color: $text-secondary;
    }

    a:not(.btn) {
      color: $accent-blue-light;
      text-decoration: underline;
    }

    .btn {
      margin-top: 1rem;
    }
  }
</style>
