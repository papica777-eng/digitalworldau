---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import HeaderNav from '../components/HeaderNav.svelte';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Terms of Engagement — Digital World AU" canonical="https://digitalworldau.com/terms">
  <AnnouncementBar />
  <HeaderNav client:load />
  <main class="section">
    <div class="container legal-wrap">
      <span class="eyebrow">Legal Framework</span>
      <h1 class="section-title">Terms of Engagement</h1>
      <p class="section-lead">
        Clear, founder-friendly commercial terms governing audits, design sprints, custom development, and 100% client IP ownership.
      </p>
      <div class="legal-card">
        <h2>1. Intellectual Property Ownership</h2>
        <p>Upon final milestone settlement, 100% of custom source code, Figma design systems, and bespoke brand assets created under your engagement transfer exclusively to your business.</p>
        <h2>2. Fixed-Scope Milestones</h2>
        <p>Every engagement operates on written deliverables, staging review windows, and transparent AUD or EUR milestone schedules.</p>
        <h2>3. Free 2-Week Expert Audit</h2>
        <p>Complimentary UX, Core Web Vitals, and Technical SEO audits carry zero obligation and are delivered as actionable written roadmaps.</p>
        <a href="/" class="btn btn-ghost">← Back to Home</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .legal-wrap {
    max-width: 820px;
  }

  .legal-card {
    @include glass-surface;
    border-radius: $radius-lg;
    padding: 2rem;
    margin-top: 2rem;

    h2 {
      margin: 1.5rem 0 0.5rem;
      font-size: 1.15rem;

      &:first-child {
        margin-top: 0;
      }
    }

    p {
      margin: 0 0 1rem;
      color: $text-secondary;
    }

    .btn {
      margin-top: 1rem;
    }
  }
</style>
