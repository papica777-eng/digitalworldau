---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import HeaderNav from '../components/HeaderNav.svelte';
import QuoteForm from '../components/QuoteForm.svelte';
import SiteFooter from '../components/SiteFooter.astro';

const schema = [
  {
    '@type': 'Service',
    name: 'Web Design & Conversion Engineering Sydney',
    serviceType: 'Web Design Agency',
    provider: { '@id': 'https://digitalworldau.com/#organization' },
    areaServed: { '@type': 'City', name: 'Sydney' },
    description:
      'Bespoke corporate websites, dark-mode luxury brand flagships, and Google Ads conversion architecture for Sydney & NSW enterprises.',
    offers: {
      '@type': 'Offer',
      priceCurrency: 'AUD',
      price: '3300',
      availability: 'https://schema.org/InStock',
    },
  },
];
---

<BaseLayout
  title="Web Design Sydney & NSW — High-Converting Corporate Websites | Digital World AU"
  description="Custom web design and performance conversion agency serving Sydney CBD & NSW. Build ultra-fast corporate websites, Google Ads landing systems, and bespoke web apps."
  canonical="https://digitalworldau.com/web-design-sydney/"
  pageType="landing"
  extraSchema={schema}
>
  <AnnouncementBar />
  <HeaderNav client:load />

  <main>
    <section class="section landing-hero">
      <div class="container">
        <span class="eyebrow">Sydney &amp; New South Wales • Enterprise Web Flagships</span>
        <h1 class="section-title">Web Design in Sydney engineered to convert enterprise traffic.</h1>
        <p class="section-lead">
          When Sydney B2B buyers and high-net-worth consumers click your link or Google Ad, slow templates cost six-figure deals. We pair unmistakable dark-mode visual authority with instant Cloudflare edge speeds and Consent Mode v2 attribution.
        </p>

        <div class="landing-actions">
          <a href="#contact" class="btn btn-primary" data-preset-service="UI/UX & Web Design">Book a Sydney Consultation</a>
          <a href="/free-website-audit/" class="btn btn-ghost">Claim Free 48-Hour Audit →</a>
        </div>

        <div class="deliverables-grid">
          <article class="deliv-card" data-glow-card>
            <h3>Higher Google Ads Quality Score</h3>
            <p>Dedicated campaign landing pages with instant sub-second load times cut Cost-Per-Click while boosting qualified inquiry conversion rates.</p>
          </article>
          <article class="deliv-card" data-glow-card>
            <h3>Executive UI/UX Design Systems</h3>
            <p>Custom typography, dark glassmorphism depth, interactive calculators, and accessible contrast tailored to financial, legal, medical &amp; luxury sectors.</p>
          </article>
          <article class="deliv-card" data-glow-card>
            <h3>Fixed-Scope AUD Transparency</h3>
            <p>Predictable milestones from A$3,300 to A$82,500 with 24-hour Australian response SLA and 100% source code &amp; intellectual property handover.</p>
          </article>
        </div>
      </div>
    </section>

    <QuoteForm
      client:load
      defaultScope="UI/UX & Web Design"
      eyebrow="Sydney & NSW Inquiries"
      heading="Launch a faster, higher-converting Sydney website."
    />
  </main>

  <SiteFooter />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .landing-hero {
    padding-bottom: 2rem;

    .section-title {
      max-width: 19ch;
    }

    .section-lead {
      max-width: 68ch;
      margin-bottom: 2rem;
    }
  }

  .landing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.75rem;
  }

  .deliverables-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;

    @include respond-up(lg) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .deliv-card {
    @include interactive-card;
    padding: 1.5rem;

    h3 {
      margin: 0 0 0.6rem;
      font-size: 1.12rem;
      color: #ffffff;
    }

    p {
      margin: 0;
      font-size: 0.92rem;
      color: $text-secondary;
    }
  }
</style>
