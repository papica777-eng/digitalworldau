---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeaderNav from '../components/HeaderNav.svelte';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Privacy Policy & Cookie Notice — Digital World AU" canonical="https://digitalworldau.com/privacy/" pageType="legal">
  <HeaderNav client:load />
  <main class="section">
    <div class="container legal-wrap">
      <span class="eyebrow">Privacy, Cookies &amp; Data Protection</span>
      <h1 class="section-title">Privacy Policy</h1>
      <p class="section-lead">
        Digital World AU complies with the Australian Privacy Principles under the Privacy Act 1988 (Cth), GDPR for European Union and Swiss clients, and Google Ads Consent Mode v2 requirements.
      </p>
      <div class="legal-card">
        <h2>1. Information You Provide</h2>
        <p>When you submit our quote or Free 48-Hour Website Audit form, we collect only the name, work email, optional phone number, estimated budget tier, project notes, and optional brief attachments you choose to share.</p>

        <h2>2. Cookies &amp; Google Ads Conversion Measurement</h2>
        <p>Essential storage preserves your display currency preference (AUD / EUR) and consent state. Optional analytics and Google Ads conversion cookies are activated only with your consent via our Cookie Preferences banner and are used solely to measure inquiry attribution.</p>

        <h2>3. Local Zero-Trust Attachment Inspection</h2>
        <p>Uploaded project briefs (.pdf, .doc, .docx, .png, .jpg up to 10MB) are verified locally inside your browser using <code>agency_wasm.wasm</code> magic-byte inspection before submission.</p>

        <h2>4. Data Access, Erasure &amp; Contact</h2>
        <p>We never sell or rent personal information. To request access, correction, or deletion of your inquiry data under Australian Privacy Principles or EU GDPR, email <a href="mailto:hello@digitalworldau.com">hello@digitalworldau.com</a>, call our Australian Desk (<a href="tel:+61423269586">+61 423 269 586</a>, 56 Mantung Crescent, Rowville, Melbourne VIC 3178, Australia) or our European Union GDPR Desk (<a href="tel:+359896849882">+359 896 849 882</a>, 6 Trapezitsa St, 8200 Pomorie, Burgas Region, Bulgaria, EU).</p>

        <a href="/" class="btn btn-ghost">← Return to Digital World AU</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;
  @use '../styles/mixins' as *;

  .legal-wrap {
    max-width: 820px;
  }

  .legal-card {
    @include glass-surface;
    border-radius: $radius-lg;
    padding: 2rem;
    margin-top: 2rem;

    h2 {
      margin: 1.5rem 0 0.5rem;
      font-size: 1.15rem;

      &:first-child {
        margin-top: 0;
      }
    }

    p {
      margin: 0 0 1rem;
      color: $text-secondary;
    }

    a:not(.btn) {
      color: $accent-blue-light;
      text-decoration: underline;
    }

    .btn {
      margin-top: 1rem;
    }
  }
</style>
