---
import '../styles/main.scss';
import CookieBanner from '../components/CookieBanner.svelte';
import FluidBackground from '../components/FluidBackground.svelte';
import { FAQ_ITEMS, SERVICES_BENTO } from '../data/agencyData';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  pageType?: 'home' | 'legal' | 'landing' | 'article';
  extraSchema?: Record<string, unknown>[];
}

const {
  title = 'Digital World AU — Web Design, E-Commerce & Google Ads Agency',
  description = 'Digital World AU crafts high-converting websites, bespoke e-commerce stores, and performance marketing systems for ambitious brands in Australia and worldwide.',
  canonical = 'https://digitalworldau.com/',
  pageType = 'home',
  extraSchema = [],
} = Astro.props;

const ga4Id = (import.meta.env.PUBLIC_GA4_ID || '').trim();
const gadsId = (import.meta.env.PUBLIC_GADS_ID || '').trim();
const gadsLeadLabel = (import.meta.env.PUBLIC_GADS_LEAD_LABEL || '').trim();
const primaryGtagId = ga4Id || gadsId;

const ogImage = 'https://digitalworldau.com/media/og-card-v2.jpg';

const breadcrumbItems =
  pageType === 'home'
    ? [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Digital World AU',
          item: 'https://digitalworldau.com/',
        },
      ]
    : [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Digital World AU',
          item: 'https://digitalworldau.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title.replace(' — Digital World AU', ''),
          item: canonical,
        },
      ];

const graph: Record<string, unknown>[] = [
  {
    '@type': 'ProfessionalService',
    '@id': 'https://digitalworldau.com/#organization',
    name: 'Digital World AU',
    url: 'https://digitalworldau.com/',
    logo: ogImage,
    image: ogImage,
    description,
    email: 'hello@digitalworldau.com',
    telephone: '+61 423 269 586',
    priceRange: 'A$500 – A$82,500',
    founder: {
      '@type': 'Person',
      name: 'Dimitar Prodromov',
      jobTitle: 'Founder & Lead Architect',
      sameAs: [
        'https://aeterna.website',
        'https://nasvetlo.website',
        'https://github.com/papica777-eng',
        'https://orcid.org/0009-0004-8070-1348',
      ],
    },
    address: {
      '@type': 'PostalAddress',
      streetAddress: '56 Mantung Crescent',
      addressLocality: 'Rowville, Melbourne',
      addressRegion: 'VIC',
      postalCode: '3178',
      addressCountry: 'AU',
    },
    location: [
      {
        '@type': 'Place',
        name: 'Digital World AU — Melbourne & Sydney Hub',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '56 Mantung Crescent',
          addressLocality: 'Rowville, Melbourne',
          addressRegion: 'VIC',
          postalCode: '3178',
          addressCountry: 'AU',
        },
      },
      {
        '@type': 'Place',
        name: 'Digital World AU — European Engineering HQ',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '6 Trapezitsa Street',
          addressLocality: 'Pomorie & Sofia',
          addressRegion: 'Burgas',
          postalCode: '8200',
          addressCountry: 'BG',
        },
      },
    ],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        telephone: '+61 423 269 586',
        contactType: 'sales',
        areaServed: 'AU',
        availableLanguage: ['English'],
      },
      {
        '@type': 'ContactPoint',
        telephone: '+359 896 849 882',
        contactType: 'technical support',
        areaServed: ['BG', 'EU'],
        availableLanguage: ['English', 'Bulgarian'],
      },
    ],
    areaServed: ['Australia', 'Europe', 'United States', 'Canada'],
    sameAs: [
      'https://github.com/papica777-eng/digitalworldau',
      'https://anchialo.com',
      'https://cptmma.com',
      'https://originalglazing.com.au',
      'https://bambuddha.com.au',
      'https://papica777-eng.github.io/aeterna-cosmic-observatory/',
      'https://aeterna.website',
      'https://nasvetlo.website',
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Digital World AU Services',
      itemListElement: SERVICES_BENTO.map((service) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: service.title,
          description: service.subtitle,
        },
      })),
    },
  },
  {
    '@type': 'WebSite',
    '@id': 'https://digitalworldau.com/#website',
    url: 'https://digitalworldau.com/',
    name: 'Digital World AU',
    inLanguage: 'en-AU',
    dateModified: '2026-11-27',
    publisher: {
      '@id': 'https://digitalworldau.com/#organization',
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];

if (pageType === 'home') {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: FAQ_ITEMS.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  });
}

if (extraSchema.length > 0) {
  graph.push(...extraSchema);
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <!-- Google Tag Manager (GTM-KHPCXK3R) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KHPCXK3R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="bdmpPW3WH7zQk9GxVp6OhjqEzUDOkWGpxyBNtGHSmEs" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-AU" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Digital World AU — Web Design, E-Commerce & Growth Feed"
      href="https://digitalworldau.com/feed.xml"
    />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Digital World AU" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Digital World AU — High-Converting Websites, E-Commerce & Google Ads Agency"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Unbounded:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline define:vars={{ ga4Id, gadsId, gadsLeadLabel, primaryGtagId }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };
      window.__dwTracking = { ga4Id: ga4Id, gadsId: gadsId, leadLabel: gadsLeadLabel, gtmId: 'GTM-KHPCXK3R' };

      var consentState = {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      };
      try {
        var rawConsent = localStorage.getItem('dw_au_cookie_consent_v1');
        if (rawConsent) {
          var parsedConsent = JSON.parse(rawConsent);
          if (parsedConsent && parsedConsent.analytics) consentState.analytics_storage = 'granted';
          if (parsedConsent && parsedConsent.ads) {
            consentState.ad_storage = 'granted';
            consentState.ad_user_data = 'granted';
            consentState.ad_personalization = 'granted';
          }
        }
      } catch (_) {}

      window.gtag('consent', 'default', consentState);
      if (primaryGtagId) {
        if (ga4Id) window.gtag('config', ga4Id, { send_page_view: true });
        if (gadsId) window.gtag('config', gadsId);
      }
    </script>
    {
      primaryGtagId && (
        <script is:inline define:vars={{ primaryGtagId }}>
          var gtmLoaded = false;
          function loadGTM() {
            if (gtmLoaded) return;
            gtmLoaded = true;
            var s = document.createElement('script');
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(primaryGtagId);
            s.async = true;
            document.head.appendChild(s);
          }
          ['scroll', 'mousemove', 'touchstart', 'click'].forEach(function (evt) {
            window.addEventListener(evt, loadGTM, { once: true, passive: true });
          });
          setTimeout(loadGTM, 3000);
        </script>
      )
    }
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KHPCXK3R"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <FluidBackground client:idle />
    <div class="page-shell">
      <slot />
    </div>
    <CookieBanner client:idle />

    <!-- Persistent Glowing Green Handset Call Button (Mobile & Desktop) -->
    <a
      href="tel:+61423269586"
      class="floating-call-btn"
      aria-label="Direct Call Melbourne Desk: +61 423 269 586"
      title="Direct Call Melbourne Desk (+61 423 269 586)"
    >
      <span class="call-pulse" aria-hidden="true"></span>
      <svg class="call-handset-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span class="call-tooltip">Call Melbourne Desk</span>
    </a>

    <style is:global lang="scss">
      .floating-call-btn {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 999;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        box-shadow: 0 0 22px rgba(16, 185, 129, 0.55), 0 4px 14px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        text-decoration: none;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;

        &:hover {
          transform: scale(1.08);
          box-shadow: 0 0 32px rgba(16, 185, 129, 0.75), 0 6px 18px rgba(0, 0, 0, 0.5);

          .call-tooltip {
            opacity: 1;
            visibility: visible;
            transform: translateX(0);
          }
        }

        .call-handset-svg {
          width: 22px;
          height: 22px;
          stroke: #ffffff;
          filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.3));
        }

        .call-pulse {
          position: absolute;
          inset: -4px;
          border-radius: 50%;
          border: 2px solid rgba(16, 185, 129, 0.6);
          animation: callPulseAnimation 2.2s infinite ease-out;
          pointer-events: none;
        }

        .call-tooltip {
          position: absolute;
          left: 64px;
          white-space: nowrap;
          background: rgba(10, 15, 29, 0.92);
          backdrop-filter: blur(10px);
          border: 1px solid rgba(16, 185, 129, 0.4);
          color: #10b981;
          font-weight: 600;
          font-size: 0.78rem;
          padding: 6px 12px;
          border-radius: 999px;
          opacity: 0;
          visibility: hidden;
          transform: translateX(-8px);
          transition: all 0.2s ease;
          pointer-events: none;
          box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
        }
      }

      @keyframes callPulseAnimation {
        0% {
          transform: scale(0.95);
          opacity: 0.8;
        }
        50% {
          transform: scale(1.22);
          opacity: 0;
        }
        100% {
          transform: scale(1.22);
          opacity: 0;
        }
      }

      @media (max-width: 640px) {
        .floating-call-btn {
          bottom: 20px;
          left: 18px;
          width: 48px;
          height: 48px;

          .call-handset-svg {
            width: 20px;
            height: 20px;
          }
        }
      }
    </style>
    <script>
      // Lightweight IntersectionObserver for smooth scroll reveals + pointer glow tracking
      const revealEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-revealed'));
      }

      document.addEventListener('pointermove', (e) => {
        const card = (e.target as HTMLElement | null)?.closest?.('[data-glow-card]') as HTMLElement | null;
        if (!card) return;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      });
    </script>
  </body>
</html>
